#!/bin/sh
# pre-push フック本体 (scripts/hooks/pre_push.py) を py -3.13 で起動する薄いシム。
# Git for Windows は core.hooksPath 配下のフックを sh.exe (MinGW) 経由で実行するため、
# .py を直接フックには置けない (実行属性/インタプリタ解決の両方が絡む)。stdin (push 対象の
# ref 列) は exec によりそのまま子プロセスへ引き継がれる。
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
exec py -3.13 "$DIR/pre_push.py" "$@"
